<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Birthday Jetty :tada:</title>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;700&display=swap" rel="stylesheet">
<style>
  body {
    margin: 0;
    font-family: 'Baloo 2', cursive;
    color: #fff;
    text-align: center;
    position: relative;
    overflow-x: hidden;
    background: url('ballons_flowers.jpg') no-repeat center center fixed;
    background-size: cover;
  }
  body::before {
    content: '';
    position: fixed;
    top:0; left:0;
    width:100%; height:100%;
    background: rgba(0,0,0,0.25);
    z-index: 0;
  }
  header {
    padding: 60px 20px;
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(6px);
    border-radius: 20px;
    margin: 20px auto;
    max-width: 90%;
    position: relative;
    z-index: 2;
    animation: float 4s ease-in-out infinite;
  }
  header h1 {
    font-size: 3rem;
    color: #FFEB3B;
    text-shadow: 2px 2px 6px #000;
    animation: pop 1s ease-in-out infinite alternate, floatText 3s ease-in-out infinite;
  }
  @keyframes pop { from { transform: scale(1); } to { transform: scale(1.1); } }
  @keyframes float { 0% { transform: translateY(0); } 50% { transform: translateY(-10px); } 100% { transform: translateY(0); } }
  @keyframes floatText { 0% { transform: translateY(0); } 50% { transform: translateY(-5px); } 100% { transform: translateY(0); } }

  .message {
    padding: 20px 20px;
    font-size: 1.2rem;
    line-height: 1.6;
    background: rgba(0,0,0,0.3);
    border-radius: 20px;
    max-width: 90%;
    margin: 20px auto;
    position: relative;
    z-index: 2;
    text-shadow: 1px 1px 4px #000;
    animation: float 4s ease-in-out infinite;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding: 20px;
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }
  .card {
    background: rgba(255,255,255,0.2);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    transition: transform 0.3s;
    aspect-ratio: 1/1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12px;
  }
  .card:hover { transform: scale(1.05); }

  .controls {
    margin: 30px;
    position: relative;
    z-index: 2;
  }
  button {
    background: #FF4081;
    color: white;
    border: none;
    padding: 12px 24px;
    margin: 10px;
    border-radius: 12px;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.3s;
    text-shadow: 1px 1px 2px #000;
  }
  button:hover { background: #E91E63; }

  #fireworks, #confetti-canvas { pointer-events: none; z-index: 999; position: fixed; top:0; left:0; width:100%; height:100%; }
  #balloons-canvas { pointer-events: none; z-index: 998; position: fixed; top:0; left:0; width:100%; height:100%; }

  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
</style>
</head>
<body>

<header>
  <h1>:birthday: Happy Birthday Jetty :tada:</h1>
  <p>Wishing you love, happiness, and endless smiles :sparkling_heart:</p>
</header>

<section class="message">
  <p>
    On your special day, I just want to remind you how amazing we are fucked up.<br>
    Every moment with you feels fucking awesome :sparkles:.<br>
    May this year bring you success, laughter, and all the happiness in the world. :cherry_blossom::gift_heart:
  </p>
</section>

<section class="grid">
  <div class="card"><img src="Img.jpg" alt="Photo"></div>
  <div class="card"><img src="Img1.jpg" alt="Photo 1"></div>
  <div class="card"><img src="Img2.jpg" alt="Photo 2"></div>
  <div class="card"><img src="Img3.jpg" alt="Photo 3"></div>
  <div class="card"><img src="Img4.jpg" alt="Photo 4"></div>
  <div class="card"><img src="Img5.jpg" alt="Photo 5"></div>
  <div class="card"><img src="Img6.jpg" alt="Photo 6"></div>
  <div class="card"><img src="Img7.jpg" alt="Photo 7"></div>
  <div class="card"><img src="Img8.jpg" alt="Photo 8"></div>
</section>

<div class="controls">
  <button id="music-btn">:musical_note: Play Music</button>
  <button id="fireworks-btn">:fireworks: Start Fireworks</button>
</div>

<audio id="bg-music" loop>
  <source src="baitikochi.mp3.mp3" type="audio/mp3">
</audio>

<canvas id="fireworks"></canvas>
<canvas id="balloons-canvas"></canvas>
<canvas id="confetti-canvas"></canvas>

<script>
  // MUSIC
  const music = document.getElementById("bg-music");
  const musicBtn = document.getElementById("music-btn");
  let isPlaying = false;
  musicBtn.addEventListener("click", () => {
    if(isPlaying){ music.pause(); musicBtn.textContent=":musical_note: Play Music"; }
    else{ music.play(); musicBtn.textContent=":double_vertical_bar: Pause Music"; }
    isPlaying = !isPlaying;
  });

  // FIREWORKS
  const fCanvas = document.getElementById("fireworks");
  const fCtx = fCanvas.getContext("2d");
  fCanvas.width = window.innerWidth; fCanvas.height = window.innerHeight;
  window.addEventListener("resize",()=>{ fCanvas.width=window.innerWidth; fCanvas.height=window.innerHeight; });

  let fireworks = [], particles = [], fireworksRunning = false, fwInterval = null;
  function randomColor(){ const r=Math.floor(Math.random()*255); const g=Math.floor(Math.random()*255); const b=Math.floor(Math.random()*255); return `rgb(${r},${g},${b})`; }

  class Firework{ constructor(x,y,targetY){ this.x=x; this.y=y; this.targetY=targetY; this.speed=5+Math.random()*3; this.exploded=false; this.color=randomColor(); this.trail=[]; }
    update(){ this.trail.push({x:this.x,y:this.y}); if(this.trail.length>5)this.trail.shift(); this.y-=this.speed; if(this.y<=this.targetY&&!this.exploded){ this.explode(); this.exploded=true; } }
    draw(){ this.trail.forEach((t,i)=>{ fCtx.fillStyle=`rgba(255,255,255,${i/this.trail.length})`; fCtx.fillRect(t.x,t.y,2,2);}); fCtx.fillStyle=this.color; fCtx.beginPath(); fCtx.arc(this.x,this.y,3,0,2*Math.PI); fCtx.fill(); }
    explode(){ for(let i=0;i<100+Math.random()*50;i++){ particles.push(new Particle(this.x,this.y,this.color)); } }
  }
  class Particle{ constructor(x,y,color){ this.x=x; this.y=y; this.color=color; this.speed=Math.random()*5+2; this.angle=Math.random()*2*Math.PI; this.alpha=1; this.decay=Math.random()*0.02+0.01; this.trail=[]; }
    update(){ this.trail.push({x:this.x,y:this.y}); if(this.trail.length>5)this.trail.shift(); this.x+=Math.cos(this.angle)*this.speed; this.y+=Math.sin(this.angle)*this.speed+0.5; this.alpha-=this.decay; }
    draw(){ this.trail.forEach((t,i)=>{ fCtx.fillStyle=`rgba(255,255,255,${(this.alpha*i)/this.trail.length})`; fCtx.fillRect(t.x,t.y,2,2); }); fCtx.fillStyle=`rgba(${this.color.match(/\d+/g).join(',')},${this.alpha})`; fCtx.beginPath(); fCtx.arc(this.x,this.y,2,0,2*Math.PI); fCtx.fill(); }
  }

  function animateFireworks(){
    fCtx.clearRect(0,0,fCanvas.width,fCanvas.height);
    fireworks.forEach((f,i)=>{ f.update(); f.draw(); if(f.exploded) fireworks.splice(i,1); });
    particles.forEach((p,i)=>{ p.update(); p.draw(); if(p.alpha<=0) particles.splice(i,1); });
    requestAnimationFrame(animateFireworks);
  }
  animateFireworks();

  document.getElementById("fireworks-btn").addEventListener("click",()=>{
    if(fireworksRunning){ clearInterval(fwInterval); fireworksRunning=false; document.getElementById("fireworks-btn").textContent=":fireworks: Start Fireworks"; }
    else{ fwInterval=setInterval(()=>{ fireworks.push(new Firework(Math.random()*fCanvas.width,fCanvas.height,Math.random()*fCanvas.height/2)); },600); fireworksRunning=true; document.getElementById("fireworks-btn").textContent=":octagonal_sign: Stop Fireworks"; }
  });

  // BALLOONS
  const bCanvas = document.getElementById("balloons-canvas");
  const bCtx = bCanvas.getContext("2d");
  bCanvas.width = window.innerWidth; bCanvas.height = window.innerHeight;

  const balloonColors = ["#FF4B4B","#FFB74D","#FFD54F","#4DD0E1","#81C784","#BA68C8"];
  const balloons = [];
  for(let i=0;i<40;i++){
    balloons.push({
      x: Math.random()*bCanvas.width,
      y: Math.random()*bCanvas.height+200,
      size: 20+Math.random()*30,
      speed: 0.5+Math.random()*1.5,
      color: balloonColors[Math.floor(Math.random()*balloonColors.length)],
      angle: Math.random()*Math.PI*2,
      swayOffset: Math.random()*1000,
      isPopped: false
    });
  }

  document.addEventListener("click",(e)=>{
    balloons.forEach(b=>{
      if(!b.isPopped){
        const dx = e.clientX - b.x;
        const dy = e.clientY - b.y;
        if(Math.sqrt(dx*dx+dy*dy)<b.size){ b.isPopped=true;
          for(let i=0;i<10;i++){ particles.push(new Particle(b.x,b.y,b.color)); }
        }
      }
    });
  });

  function animateBalloons(){
    bCtx.clearRect(0,0,bCanvas.width,bCanvas.height);
    balloons.forEach(b=>{
      if(!b.isPopped){
        b.y -= b.speed;
        b.x += Math.sin((Date.now()+b.swayOffset)/1000)*0.5;
        b.angle += 0.01;
        if(b.y + b.size < 0){ b.y = bCanvas.height+50; b.x = Math.random()*bCanvas.width; b.isPopped=false; }

        bCtx.save();
        bCtx.translate(b.x,b.y);
        bCtx.rotate(Math.sin(b.angle)*0.2);
        bCtx.beginPath();
        bCtx.fillStyle=b.color;
        bCtx.ellipse(0,0,b.size*0.6,b.size,0,0,2*Math.PI);
        bCtx.fill();
        bCtx.beginPath();
        bCtx.strokeStyle="#333";
        bCtx.moveTo(0,b.size);
        bCtx.lineTo(0,b.size+20);
        bCtx.stroke();
        bCtx.restore();
      }
    });
    requestAnimationFrame(animateBalloons);
  }
  animateBalloons();
</script>
</body>
</html>
